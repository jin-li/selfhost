BIND_ADDRESS=127.0.0.1
DATA_DIR=/srv/tts-qwen
QWEN_IMAGE=ghcr.io/malaiwah/qwen3-tts-server:latest

# Set to 1 only after the pinned snapshot has been cached completely.
HF_HUB_OFFLINE=0

# On-demand GPU sharing (off by default). Needs the -ondemand1 image or later.
QWEN_LAZY_LOAD=0
QWEN_IDLE_UNLOAD_S=0
QWEN_MIN_FREE_VRAM_MIB=0
